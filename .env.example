# ==========================================
# Soma Token Deployment Configuration (.env)
# ==========================================

# ১. আপনার টেস্টনেট ওয়ালেটের ২৪টি সিড ফ্রেইজ (Seed phrase / Mnemonic words)
# (শব্দগুলোর মাঝে একটি স্পেস দিয়ে লিখবেন)
WALLET_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24"

# ২. ওয়ালেট ভার্সন (Tonkeeper এর সাধারণ স্ট্যান্ডার্ড হলো v4 বা v5r1)
WALLET_VERSION="v4"

# ৩. (ঐচ্ছিক) টোকেন মেটাডাটা JSON এর পাবলিক URL
# আপনি চাইলে GitHub Raw URL বা IPFS URL দিতে পারেন
METADATA_URI="https://raw.githubusercontent.com/bnbxeth/soma-token/main/metadata.json"

# ৪. (ঐচ্ছিক) যদি ডিপ্লয়ার ওয়ালেট ছাড়া অন্য কোনো ওয়ালেটকে Admin বানাতে চান
# ফাঁকা রাখলে আপনার নিজের ওয়ালেটই Admin হবে
ADMIN_ADDRESS=""
